upstream campus_api {
    server api:5001;
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

upstream campus_portal {
    server portal:8080;
    keepalive 16;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

upstream campus_web {
    server web:3000;
    keepalive 32;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

upstream campus_plugin_daemon {
    server plugin_daemon:5002;
    keepalive 8;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    include /etc/nginx/campus-branding/logo-locations.conf;

    location = /_campus_access_check {
      internal;
      proxy_pass http://campus_api/console/api/campus/session/access-check;
      proxy_pass_request_body off;
      proxy_set_header Content-Length "";
      proxy_set_header X-Original-URI $request_uri;
      proxy_set_header Cookie "campus_portal_session=$cookie_campus_portal_session";
      include proxy.conf;
    }

    # Administration lives on the host-loopback listener below, and the portal
    # page there calls these routes on its own origin. Nothing on a campus
    # interface needs them, so they are not published here. The backend still
    # requires a named administrator; this only removes the surface.
    location ^~ /console/api/campus/admin/ {
      return 404;
    }

    location ^~ /console/api/campus/ {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location = /portal {
      return 308 /portal/;
    }

    location ^~ /portal/ {
      proxy_pass http://campus_portal/;
      include proxy.conf;
    }

    location = / {
      auth_request /_campus_access_check;
      error_page 401 = @campus_portal_entry;
      error_page 403 = @campus_portal_entry;
      proxy_pass http://campus_web;
      include proxy.conf;
    }

    location @campus_portal_entry {
      return 302 /portal/;
    }

    location = /signin {
      return 302 /portal/;
    }

    # Dify's logout must also end the server-side Campus portal session. The
    # endpoint remains callable after a reservation expires so logout cannot be
    # blocked by the access check it is intended to invalidate.
    location = /console/api/logout {
      proxy_pass http://campus_api/console/api/campus/session/logout;
      include proxy.conf;
    }

    # Student authentication is available only through the Access portal.
    # Named administrators use the host-loopback-only listener below.
    location ~ ^/(activate|forgot-password|reset-password|signin|signup)(/|$) {
      return 404;
    }

    location ~ ^/console/api/(activate|email-code-login|forgot-password|login|oauth/(authorize|login)|reset-password)(/|$) {
      return 404;
    }

    # Every model call must be metered by the gateway, so a student may read the
    # managed provider list their workspace was given but never add, change, or
    # remove one. limit_except GET also permits HEAD.
    location ^~ /console/api/workspaces/current/model-providers {
      auth_request /_campus_access_check;
      limit_except GET {
        deny all;
      }
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /console/api {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /api {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /socket.io/ {
      auth_request /_campus_access_check;
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /openapi {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /files {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /explore {
      auth_request /_campus_access_check;
      proxy_pass http://campus_web;
      include proxy.conf;
    }

    # Plugin callbacks must remain service-to-service accessible.
    location /e/ {
      proxy_pass http://campus_plugin_daemon;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location / {
      auth_request /_campus_access_check;
      proxy_pass http://campus_web;
      include proxy.conf;
    }

    location /mcp {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /triggers {
      auth_request /_campus_access_check;
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location = /health {
      proxy_pass http://campus_api/health;
      include proxy.conf;
    }

    ${ACME_CHALLENGE_LOCATION}
    ${HTTPS_CONFIG}
}

# The stock Dify administration surface is never published on a campus
# interface. Docker binds this listener to host loopback for named admins.
server {
    listen 8081;
    server_name _;

    include /etc/nginx/campus-branding/logo-locations.conf;

    # The Campus administration portal owns the listener root; the upstream
    # Dify console stays reachable on its own routes (/signin, /apps, ...).
    location = / {
      root /campus-admin-html;
      add_header Cache-Control "no-cache" always;
      try_files /index.html =404;
    }

    location ^~ /campus-admin/ {
      alias /campus-admin-html/;
      add_header Cache-Control "no-cache" always;
      try_files $uri =404;
    }

    location /console/api {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /api {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /socket.io/ {
      resolver 127.0.0.11 valid=30s ipv6=off;
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location /v1 {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /openapi {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /files {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /explore {
      proxy_pass http://campus_web;
      include proxy.conf;
    }

    location /e/ {
      proxy_pass http://campus_plugin_daemon;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location / {
      proxy_pass http://campus_web;
      include proxy.conf;
    }

    location /mcp {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location /triggers {
      proxy_pass http://campus_api;
      include proxy.conf;
    }

    location = /health {
      proxy_pass http://campus_api/health;
      include proxy.conf;
    }
}
