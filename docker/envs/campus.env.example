# Copy to campus.env, replace every change-me value, chmod 600, and pass it
# with: docker compose --env-file ./envs/campus.env ...
COMPOSE_PROJECT_NAME=njit-campus
CAMPUS_NGINX_BIND_ADDRESS=127.0.0.1
CAMPUS_IMAGE_TAG=phase-1
CAMPUS_WEB_IMAGE_TAG=phase-1
CAMPUS_WEB_COMMIT_SHA=campus
CAMPUS_GATEWAY_IMAGE_TAG=phase-1
CAMPUS_DIFY_API_BASE_IMAGE=langgenius/dify-api@sha256:bd3e8b15cfc47e89dc7a0d17431e6f3289244f4b442b96e2372bd0f0646f3d58

# Optional registry mirrors must retain the pinned digests.
CAMPUS_GATEWAY_BUN_IMAGE=oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7
CAMPUS_GATEWAY_GO_IMAGE=golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039
CAMPUS_GATEWAY_RUNTIME_IMAGE=debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
CAMPUS_GATEWAY_GO_PROXY=https://proxy.golang.org,direct

# Canary ports. Keep the current port-80 Dify deployment untouched until acceptance passes.
EXPOSE_NGINX_PORT=18080
EXPOSE_NGINX_SSL_PORT=18443
CAMPUS_ADMIN_PORT=18081
EXPOSE_PLUGIN_DEBUGGING_PORT=15003
NGINX_HTTPS_ENABLED=false
CAMPUS_PORTAL_COOKIE_SECURE=false
CAMPUS_BASELINE_URL=http://127.0.0.1/
CAMPUS_API_WORKER_AMOUNT=2
CAMPUS_API_WORKER_CLASS=gevent
CAMPUS_API_WORKER_CONNECTIONS=200
CAMPUS_BASELINE_CONCURRENCY=100
CAMPUS_BASELINE_REQUESTS_PER_USER=1
CAMPUS_BASELINE_DURATION_SECONDS=300
CAMPUS_BASELINE_MAX_P99_MS=100

# Accepted front-door promotion. `manage.sh promote` preserves the upstream
# baseline on loopback before enabling these values; do not flip the flag by
# hand while another container owns TCP 80.
CAMPUS_PUBLIC_ENTRY_ENABLED=false
CAMPUS_PUBLIC_BIND_ADDRESS=10.20.10.193
CAMPUS_PUBLIC_HTTP_PORT=80
CAMPUS_PUBLIC_REMOTE_ADDRESS=10.0.0.0/255.0.0.0
CAMPUS_UPSTREAM_DOCKER_DIR=/mnt/d/Projects/dify-main/docker
CAMPUS_UPSTREAM_PROJECT_NAME=dify-mian-20260725
CAMPUS_UPSTREAM_HTTP_PORT=18082
CAMPUS_UPSTREAM_HTTPS_PORT=18444

CAMPUS_ENABLED=true
CAMPUS_VIRTUAL_IDENTITY_ENABLED=true
CAMPUS_VIRTUAL_IDENTITIES_JSON=[{"student_number":"virtual-001","display_name":"Virtual Student 1","cohort":"demo","login_code":"change-me"},{"student_number":"virtual-002","display_name":"Virtual Student 2","cohort":"demo","login_code":"change-me"}]
CAMPUS_BOOTSTRAP_ADMIN_ACCOUNT_IDS=change-me-first-dify-account-id,change-me-second-dify-account-id
CAMPUS_SERVICE_PRINCIPAL_EMAIL=change-me-service-principal@example.invalid
CAMPUS_DEFAULT_ALLOWANCE_USD=20
CAMPUS_RESERVATION_CAPACITY=500
CAMPUS_BOOKING_DAYS=7
CAMPUS_CURRENT_SLOT_MAX_LOAD_PER_CPU=1.0
CAMPUS_PORTAL_SESSION_TTL_HOURS=12
CAMPUS_PORTAL_COOKIE_NAME=campus_portal_session

# This PAT is held only by the Campus API. It must belong to an isolated gateway admin.
CAMPUS_NEWAPI_ADMIN_ACCESS_TOKEN=change-me
CAMPUS_NEWAPI_ADMIN_USER_ID=1
CAMPUS_NEWAPI_GROUP=campus
CAMPUS_NEWAPI_MODEL_LIMITS=
# Assign only models that each upstream channel can actually serve. The legacy
# REQUIRED_CHANNEL_* keys remain supported when this JSON value is absent.
CAMPUS_NEWAPI_CHANNEL_MODELS_JSON={"1":{"channel_type":43,"base_url":"","models":["deepseek-v4-flash","deepseek-v4-pro","deepseek-v4-flash-vision-exp"]},"2":{"channel_type":1,"base_url":"https://ai.ctaigw.cn","models":["bge-m3","bge-reranker-v2-m3","qwen3.8-flash","qwen-audio-3.0-asr-flash","doubao-seedream-5.0-pro"]}}
CAMPUS_NEWAPI_PRESERVE_CHANNEL_MODELS=true
CAMPUS_NEWAPI_UPSTREAM_SYNC_INTERVAL_SECONDS=300
CAMPUS_NEWAPI_REQUIRED_CHANNEL_IDS=
CAMPUS_NEWAPI_REQUIRED_CHANNEL_MODELS=
CAMPUS_NEWAPI_RETIRED_CHANNEL_IDS=
CAMPUS_NEWAPI_QUOTA_UNITS_PER_USD=500000

CAMPUS_MODEL_PROVIDER=langgenius/openai_api_compatible/openai_api_compatible
CAMPUS_MODEL_PROVIDER_PLUGIN_UNIQUE_IDENTIFIER=change-me-copy-docker-campus-approved-provider-plugin-txt
CAMPUS_MODEL_PROVIDER_CREDENTIAL_NAME=Campus managed
CAMPUS_MODEL_PROVIDER_CREDENTIAL_SCOPE=model
CAMPUS_MODEL_PROVIDER_API_KEY_FIELD=api_key
CAMPUS_MODEL_PROVIDER_BASE_URL_FIELD=endpoint_url
# Gateway models exposed in every student workspace, as comma-separated type:name
# pairs. Every name must be priced in the gateway; at least one must be an llm.
CAMPUS_MODEL_PROVIDER_MODELS=llm:deepseek-v4-flash,llm:qwen3.8-flash,text-embedding:bge-m3,rerank:bge-reranker-v2-m3
CAMPUS_MODEL_PROVIDER_API_PROTOCOL=chat

# The gateway is reachable externally only on server loopback for administrator bootstrap.
CAMPUS_GATEWAY_ADMIN_PORT=13000
CAMPUS_GATEWAY_DB_USER=campus_gateway
CAMPUS_GATEWAY_DB_PASSWORD=change-me
CAMPUS_GATEWAY_DB_NAME=campus_gateway
CAMPUS_GATEWAY_DB_DSN=postgresql://campus_gateway:change-me@model-gateway-db:5432/campus_gateway
CAMPUS_GATEWAY_REDIS_PASSWORD=change-me
CAMPUS_GATEWAY_REDIS_CONN_STRING=redis://:change-me@model-gateway-redis:6379/0
CAMPUS_GATEWAY_SESSION_SECRET=change-me-at-least-32-random-characters
