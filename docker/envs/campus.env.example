# Copy to campus.env, replace every change-me value, chmod 600, and pass it
# with: docker compose --env-file ./envs/campus.env ...
COMPOSE_PROJECT_NAME=njit-campus
CAMPUS_IMAGE_TAG=phase-1
CAMPUS_GATEWAY_IMAGE_TAG=phase-1

# Optional registry mirrors must retain the pinned digests.
CAMPUS_GATEWAY_BUN_IMAGE=oven/bun:1@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7
CAMPUS_GATEWAY_GO_IMAGE=golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039
CAMPUS_GATEWAY_RUNTIME_IMAGE=debian:bookworm-slim@sha256:f06537653ac770703bc45b4b113475bd402f451e85223f0f2837acbf89ab020a
CAMPUS_GATEWAY_GO_PROXY=https://proxy.golang.org,direct

# Canary ports. Keep the current port-80 Dify deployment untouched until acceptance passes.
EXPOSE_NGINX_PORT=18080
EXPOSE_NGINX_SSL_PORT=18443
EXPOSE_PLUGIN_DEBUGGING_PORT=15003
NGINX_HTTPS_ENABLED=false
CAMPUS_PORTAL_COOKIE_SECURE=false
CAMPUS_BASELINE_URL=http://127.0.0.1/

CAMPUS_ENABLED=true
CAMPUS_VIRTUAL_IDENTITY_ENABLED=true
CAMPUS_VIRTUAL_IDENTITIES_JSON=[{"student_number":"virtual-001","display_name":"Virtual Student","cohort":"dev","login_code":"change-me"}]
CAMPUS_BOOTSTRAP_ADMIN_ACCOUNT_IDS=change-me-dify-account-id
CAMPUS_SERVICE_PRINCIPAL_EMAIL=change-me-service-principal@example.invalid
CAMPUS_DEFAULT_ALLOWANCE_YUAN=20
CAMPUS_RESERVATION_CAPACITY=500
CAMPUS_BOOKING_DAYS=7
CAMPUS_PORTAL_SESSION_TTL_HOURS=12
CAMPUS_PORTAL_COOKIE_NAME=campus_portal_session

# This PAT is held only by the Campus API. It must belong to an isolated gateway admin.
CAMPUS_NEWAPI_ADMIN_ACCESS_TOKEN=change-me
CAMPUS_NEWAPI_ADMIN_USER_ID=1
CAMPUS_NEWAPI_GROUP=campus
CAMPUS_NEWAPI_MODEL_LIMITS=
CAMPUS_NEWAPI_QUOTA_UNITS_PER_YUAN=500000

CAMPUS_MODEL_PROVIDER=langgenius/openai/openai
CAMPUS_MODEL_PROVIDER_CREDENTIAL_NAME=Campus managed
CAMPUS_MODEL_PROVIDER_API_KEY_FIELD=openai_api_key
CAMPUS_MODEL_PROVIDER_BASE_URL_FIELD=openai_api_base

# The gateway is reachable externally only on server loopback for administrator bootstrap.
CAMPUS_GATEWAY_ADMIN_PORT=13000
CAMPUS_GATEWAY_DB_USER=campus_gateway
CAMPUS_GATEWAY_DB_PASSWORD=change-me
CAMPUS_GATEWAY_DB_NAME=campus_gateway
CAMPUS_GATEWAY_DB_DSN=postgresql://campus_gateway:change-me@model-gateway-db:5432/campus_gateway
CAMPUS_GATEWAY_REDIS_PASSWORD=change-me
CAMPUS_GATEWAY_REDIS_CONN_STRING=redis://:change-me@model-gateway-redis:6379/0
CAMPUS_GATEWAY_SESSION_SECRET=change-me-at-least-32-random-characters
